<?xml version="1.0"?>
<ruleset name="RH Base">
	<description>WordPress coding standards for RH Base theme PHP.</description>

	<rule ref="WordPress" />

	<file>.</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
</ruleset>
