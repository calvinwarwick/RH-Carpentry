# Copy to .env if you use a wrapper script, or export before deploy.
# Used by scripts/deploy-themes.sh

# SSH host from ~/.ssh/config (SiteGround or other host)
REMOTE_HOST=sg-calvinw15

# Remote path to wp-content/themes (no trailing slash)
REMOTE_BASE=/home/customer/www/rhcarpentry.uk/public_html/wp-content/themes

# Optional: public_html root for WP-CLI hint only (must match your server layout)
PUBLIC_HTML=/home/customer/www/rhcarpentry.uk/public_html

